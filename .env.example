# Copy to .env and fill in real values. .env is git-ignored; never commit it.
NODE_ENV=development
PORT=3000

# PostgreSQL (also consumed by docker-compose.yml)
POSTGRES_USER=docapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=document_service
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docapi:change-me@localhost:5432/document_service

# Shared secret used to verify HS256 access tokens issued by the platform identity service (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=
JWT_AUDIENCE=

# 64-bit Snowflake generator node id (0-1023), unique per running instance
SNOWFLAKE_NODE_ID=1

# Document limits
MAX_BODY_BYTES=2097152
MAX_DOCUMENT_BYTES=2097152
MAX_NODES=5000
MAX_DEPTH=32

# Behaviour
IDEMPOTENCY_TTL_HOURS=48
LOCK_TTL_SECONDS=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_MS=2000
